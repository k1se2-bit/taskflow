rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(orgId) {
      return signedIn() && get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerId == request.auth.uid;
    }
    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
      match /tasks/{taskId} { allow read, write: if signedIn() && request.auth.uid == userId; }
    }
    match /organizations/{orgId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['name', 'ownerId', 'memberIds', 'createdAt'])
        && request.resource.data.keys().hasOnly(['name', 'ownerId', 'memberIds', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 100
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() <= 50
        && request.resource.data.ownerId in request.resource.data.memberIds;
      allow delete: if false;
      match /joinRequests/{userId} {
        allow read: if signedIn() && (request.auth.uid == userId || owner(orgId));
        allow create: if signedIn() && request.auth.uid == userId
          && exists(/databases/$(database)/documents/organizations/$(orgId))
          && !(userId in get(/databases/$(database)/documents/organizations/$(orgId)).data.memberIds)
          && request.resource.data.keys().hasAll(['uid', 'name', 'createdAt'])
          && request.resource.data.keys().hasOnly(['uid', 'name', 'createdAt'])
          && request.resource.data.uid == userId
          && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 80
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if signedIn() && (request.auth.uid == userId || owner(orgId));
      }
    }
  }
}
